{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFA Loader",
  "version": "1.0.0",
  "identifier": "shop.shefu223.nfa",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "shefu223 NFA Loader",
        "width": 900,
        "height": 740,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.steamstatic.com https://*.steamstatic.com https://*.akamaihd.net; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
